# syntax=docker/dockerfile:1.7
FROM docker.io/library/debian@sha256:5ae3c39ebd15e229dcedd5cee596b2497182493d41ff162e824ba13fc1b2b867 AS verify
COPY target/mrml-native/linux/release/mrml-gitd /payload/mrml-gitd
RUN test -x /payload/mrml-gitd && ! ldd /payload/mrml-gitd | grep -q 'not found' && \
    install -d -o 21001 -g 21001 -m 0755 /payload/rootfs/usr/bin && \
    install -o 21001 -g 21001 -m 0755 /payload/mrml-gitd /payload/rootfs/usr/bin/mrml-gitd && \
    install -d -o 21001 -g 21001 -m 0700 \
      /payload/rootfs/mnt/mrml/gitd/repos /payload/rootfs/mnt/mrml/gitd/state \
      /payload/rootfs/mnt/mrml/gitd/quarantine /payload/rootfs/mnt/mrml/gitd/cache \
      /payload/rootfs/mnt/mrml/gitd/receipts && \
    install -d -o 21001 -g 21001 -m 0755 /payload/rootfs/mnt/mrml/gitd/policies && \
    install -d -o 21002 -g 21901 -m 2770 /payload/rootfs/run/mrml/git-authority && \
    install -d -o 21003 -g 21902 -m 2770 /payload/rootfs/run/mrml/certd-gitd

FROM gcr.io/distroless/cc-debian12@sha256:777e96cf322c46bc32aca926c263624c4dc8d7cf37e2fa65ba2c7e697318ebbb
COPY --from=verify /payload/rootfs/ /
USER 21001:21001
ENTRYPOINT ["/usr/bin/mrml-gitd"]
