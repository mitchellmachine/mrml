# syntax=docker/dockerfile:1.7
FROM docker.io/library/debian@sha256:5ae3c39ebd15e229dcedd5cee596b2497182493d41ff162e824ba13fc1b2b867 AS verify
COPY target/mrml-native/linux/release/mrml-git-protected-signer /payload/mrml-git-protected-signer
RUN test -x /payload/mrml-git-protected-signer && ! ldd /payload/mrml-git-protected-signer | grep -q 'not found' && \
    install -d -o 21006 -g 21906 -m 2770 /payload/socket && \
    install -d -o 21006 -g 21006 -m 0700 /payload/keys /payload/state /payload/channel

FROM gcr.io/distroless/cc-debian12@sha256:777e96cf322c46bc32aca926c263624c4dc8d7cf37e2fa65ba2c7e697318ebbb
COPY --from=verify --chown=21006:21006 /payload/mrml-git-protected-signer /usr/bin/mrml-git-protected-signer
COPY --from=verify --chown=21006:21906 /payload/socket /run/mrml/git-protected-signer
COPY --from=verify --chown=21006:21006 /payload/keys /var/lib/mrml/git-protected-signer/keys
COPY --from=verify --chown=21006:21006 /payload/state /var/lib/mrml/git-protected-signer/state
COPY --from=verify --chown=21006:21006 /payload/channel /run/secrets
USER 21006:21006
ENTRYPOINT ["/usr/bin/mrml-git-protected-signer"]
