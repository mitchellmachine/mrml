# syntax=docker/dockerfile:1.7
FROM docker.io/library/debian@sha256:5ae3c39ebd15e229dcedd5cee596b2497182493d41ff162e824ba13fc1b2b867 AS verify
COPY target/mrml-native/linux/release/mrml-certd /payload/mrml-certd
RUN test -x /payload/mrml-certd && ! ldd /payload/mrml-certd | grep -q 'not found' && \
    install -d -o 21003 -g 21003 -m 0700 /payload/dirs/state /payload/dirs/publications && \
    install -d -o 21003 -g 21902 -m 2750 /payload/dirs/certd-gitd && \
    install -d -o 21003 -g 21903 -m 2750 /payload/dirs/certd-acmed

FROM gcr.io/distroless/cc-debian12@sha256:777e96cf322c46bc32aca926c263624c4dc8d7cf37e2fa65ba2c7e697318ebbb
COPY --from=verify --chown=21003:21003 /payload/mrml-certd /usr/bin/mrml-certd
COPY --from=verify --chown=21003:21003 /payload/dirs/state /var/lib/mrml/certd
COPY --from=verify --chown=21003:21003 /payload/dirs/publications /var/lib/mrml/publications
COPY --from=verify --chown=21003:21902 /payload/dirs/certd-gitd /run/mrml/certd-gitd
COPY --from=verify --chown=21003:21903 /payload/dirs/certd-acmed /run/mrml/certd-acmed
USER 21003:21003
ENTRYPOINT ["/usr/bin/mrml-certd"]
CMD ["serve"]
